# Required — core cannot ingest without Supabase Storage.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Required — VLM calls (analyzers) and answer synthesis.
OPENAI_API_KEY=sk-...

# Only needed for the `diarization` analyzer. Its model is gated — accept the
# terms at https://huggingface.co/pyannote/speaker-diarization-community-1 first.
HF_TOKEN=hf_...

# Bearer token core's routes require, if set. Leave unset for a machine-local
# dev server. Must match CORE_API_TOKEN in frontend/.env.local.
# VIDEOMIND_API_TOKEN=

# --- Storage / paths ---------------------------------------------------

# Supabase Storage bucket video bytes live in.
# VIDEOMIND_BUCKET=videos

# Cap on a server-side fetch of a caller-supplied URL, in bytes.
# VIDEOMIND_MAX_BYTES=4294967296

# Root all other VIDEOMIND_* paths default under.
# VIDEOMIND_ROOT=.

# Everything core writes: records, vector store, uploads, cache, model
# weights. Override individually, or move the whole tree with VIDEOMIND_DATA.
# VIDEOMIND_DATA=./data
# VIDEOMIND_RECORDS=./data/records
# VIDEOMIND_VECTORDB=./data/vectordb
# VIDEOMIND_UPLOADS=./data/uploads
# VIDEOMIND_CACHE=./data/cache
# VIDEOMIND_MODELS=./data/models
# VIDEOMIND_MEDIA=./media

# Set to 0/false/no to drop core's own web UI (API-only mode). Same as
# `serve.py --api-only`.
# VIDEOMIND_UI=1

# --- YouTube ingest ------------------------------------------------------

# ffmpeg binary, if not on PATH. Without one, YouTube ingests cap at 360p —
# 1080p is published as separate video/audio streams that only ffmpeg can join.
# VIDEOMIND_FFMPEG=

# Longest YouTube video accepted, in seconds.
# VIDEOMIND_YT_MAX_DURATION=3600

# For YouTube videos that refuse anonymous clients.
# VIDEOMIND_YT_COOKIES=cookies.txt
# VIDEOMIND_YT_COOKIES_FROM_BROWSER=chrome
